# ABD UNI PROJECT — abduniproject — .env.example (CANONICAL)
# All secrets/configs MUST be here (Rule 17 & 38). Validate via env() at startup.
# Laragon = local dev only | Docker = production only (never cross-apply)

APP_NAME="ABD UNI PROJECT"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://abduniproject.test
APP_ID="AU BUSINESS"
# Supported app_id values (space-form): "AU BUSINESS","AU MED","AU DEALS","AU SERV","AU INVEST"

# --- Frontend / Vite ---
VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="localhost"
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# --- Database Core — MySQL 8.4 LTS (InnoDB, utf8mb4, native Spatial) ---
# Sole relational source for platform core (Rule: never JSONB, use JSON)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=abduniproject
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# --- Database Replica (B2-F5 — heartbeat lag, no REPLICATION CLIENT) ---
DB_REPLICA_HOST=127.0.0.1
DB_REPLICA_PORT=3306
DB_REPLICA_LAG_THRESHOLD=5
DB_ISOLATION_LEVEL="READ COMMITTED"

# --- Logging (B2-F7 — salted HMAC + allowlist) ---
LOG_CHANNEL=single
LOG_LEVEL=info
LOG_HMAC_KEY=arena-log-salt-v1-change-in-prod

# --- Database Clinical — PostgreSQL 16 (PostGIS + pgcrypto) for AU MED only ---
# Exclusive PHI store, AES-256-GCM via pgcrypto
DB_PGSQL_CONNECTION=pgsql
DB_PGSQL_HOST=127.0.0.1
DB_PGSQL_PORT=5432
DB_PGSQL_DATABASE=abduniproject_clinical
DB_PGSQL_USERNAME=postgres
DB_PGSQL_PASSWORD=
# PostGIS & pgcrypto must be enabled: CREATE EXTENSION postgis; CREATE EXTENSION pgcrypto;
PGCRYPTO_KEY=arena-pgcrypto-key-v1-change-in-prod
TELEMETRY_HMAC_KEY=arena-telemetry-hmac-v1-change-in-prod

# --- Redis (Cache, Queues, Mutex Locks) ---
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

# --- Reverb (Exclusive Realtime Driver — port 8080, wss:// in prod) — BROADCAST_PORT alias for B.10 F-03 ---
BROADCAST_CONNECTION=reverb
BROADCAST_PORT=8080
REVERB_APP_ID=my-app-id
REVERB_APP_KEY=my-reverb-key
REVERB_APP_SECRET=my-reverb-secret
REVERB_HOST="0.0.0.0"
REVERB_PORT=8080
REVERB_SCHEME=http
# In production behind Nginx/Cloudflare: REVERB_SCHEME=https + wss://

# --- Encryption & Auth ---
# AES-256-GCM for PHI (pgcrypto) + TLS 1.3 in transit
BCRYPT_ROUNDS=12
SESSION_LIFETIME=120
SANCTUM_STATEFUL_DOMAINS=abduniproject.test

# --- Silent Token Rotation (Pillar 9) — B.6 hardened F-04 — __Host-refresh hashed family ---
JWT_SECRET=arena-jwt-secret-v1-change-in-prod-must-be-32+chars
JWT_TTL=15
JWT_REFRESH_TTL=20160
JWT_REFRESH_COOKIE=__Host-refresh
# Set-Cookie attributes: Secure; HttpOnly; SameSite=Lax; Path=/api; Max-Age=604800 — never store refresh in localStorage
TRUST_PROXIES=*
CORS_ALLOW_ORIGINS=http://abduniproject.test
CORS_ALLOW_CREDENTIALS=true

# --- Exchange Rates (Multi-Currency Ledger — no base currency bias) ---
# Every app_wallets record has explicit currency (EGP, USD, SAR, AED, etc.)
# Live FX via configurable provider; cross-border deals freeze rate at exchange_rate_locked_at
FX_PROVIDER=exchangerate_api
FX_API_KEY=
FX_SYNC_CRON="*/30 * * * *"

# --- AI Drivers (Tri-Hybrid Switcher — B.4 Hardened) ---
LOCAL_GPU_ENDPOINT=http://vllm_gpu:8000/v1
LOCAL_GPU_ALLOWLIST=http://vllm_gpu:8000/v1,http://vllm_gpu:8000,http://vllm:8001,http://127.0.0.1:8001,http://localhost:8001
LOCAL_GPU_COST_PER_1K=0.001
AI_FALLBACK_THRESHOLD=90
CLOUD_LLM_PROVIDER=openai
CLOUD_LLM_API_KEY=
CLOUD_LLM_BASE_URL=https://api.openai.com/v1
CLOUD_LLM_MODEL=gpt-4o-mini
CALIBRATOR_ENABLED=true
CALIBRATOR_HEALTH_THRESHOLD=90
CLOCK_SKEW_MARGIN=30

# --- DRM Poison Pill (B.3 — 7-day grace + 48h heartbeat) ---
DRM_VERIFY_URL=
DRM_HMAC_KEY=arena-drm-hmac-v1-change-in-prod
DRM_RSA_PUBLIC_KEY=
DRM_HEARTBEAT_INTERVAL=5
DRM_GRACE_DAYS=7
DRM_HEARTBEAT_FAIL_THRESHOLD=576
DRM_LICENSE_ENCRYPTED=
DRM_TOTP_SECRET=JBSWY3DPEHPK3PXP

# --- Feature Flags (AU Lite — CheckModuleStatus → 503) ---
# Values: enabled | hibernated (dynamic via feature_flags table)
FEATURE_AU_DEALS=enabled
FEATURE_AU_SERV=enabled
FEATURE_AU_INVEST=enabled
FEATURE_AU_MED=enabled

# --- Workforce Marketplace (B.9 — buyout SaaS-only + subscription escrow 12h grace) ---
WORKFORCE_COMMISSION_RATE=5.0
WORKFORCE_SUBSCRIPTION_GRACE_HOURS=12
WORKFORCE_CATALOG_CACHE_TTL=60
WORKFORCE_DISPATCH_THROTTLE=30

# --- Mail / Storage (placeholders — never hardcode) ---
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
FILESYSTEM_DISK=local
AWS_BUCKET=

# --- Ephemeral Swarm & Healing (B.13 F-15 — max containers 10 + loops 15/30) ---
EPHEMERAL_MAX_CONTAINERS=10
SECURITY_LOOP_INTERVAL=15
REFACTOR_LOOP_INTERVAL=30
DOCKER_HOST=tcp://docker-socket-proxy:2375

# --- Queue Bulkhead (B.12 F-11/F-15 — 4 queues critical/standard/low/ai — never block critical) ---
QUEUE_FAILED_DRIVER=database-uuids
QUEUE_FAILED_TABLE=failed_jobs
QUEUE_DEFAULT=default
QUEUE_RETRY_AFTER=90
HORIZON_BALANCE=auto
# Four logical queues on single Redis DB 2 — separate worker pools per docker-compose.prod.yml

# --- Super Admin Seeder (B.12 F-02 — immutable root AU BUSINESS) ---
SUPERADMIN_EMAIL=superadmin@abduni.com
SUPERADMIN_PASS=Arena-Super-2026!

# --- Production Edge (Docker only — never in Laragon) ---
# Cloudflare Enterprise / WAF + Nginx max 20 req/sec + Fail2ban
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
NGINX_RATE_LIMIT=20
