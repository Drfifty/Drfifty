{
    "name": "abduniproject/abduniproject",
    "description": "ABD UNI PROJECT — Modular Monolith (Laravel 12, PHP 8.4) — B2B Core + 4 B2C Apps",
    "type": "project",
    "require": {
        "php": "^8.4",
        "laravel/framework": "^12.0",
        "laravel/reverb": "^1.0",
        "laravel/sanctum": "^4.0",
        "inertiajs/inertia-laravel": "^2.0",
        "predis/predis": "^2.2",
        "intervention/image": "^3.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "pestphp/pest": "^3.0",
        "fakerphp/faker": "^1.23"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "App\\Modules\\AUBusiness\\": "app/Modules/AUBusiness/",
            "App\\Modules\\AUMed\\": "app/Modules/AUMed/",
            "App\\Modules\\AUDeals\\": "app/Modules/AUDeals/",
            "App\\Modules\\AUInvest\\": "app/Modules/AUInvest/",
            "App\\Modules\\AUServ\\": "app/Modules/AUServ/",
            "App\\Modules\\Shared\\": "app/Modules/Shared/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
